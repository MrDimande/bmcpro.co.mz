---
import { Briefcase, Users, TrendingUp, Lightbulb, Sparkles, Target, Rocket } from 'lucide-astro';
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden pt-20">
	<!-- Background Base -->
	<div class="absolute inset-0 bg-gradient-to-br from-dark-200 via-slate-900 to-dark-200"></div>
	
	<!-- Tech Grid Pattern -->
	<div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23FFB800&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
	
	<!-- Animated Gradient Orbs -->
	<div class="absolute top-1/4 left-1/6 w-80 h-80 bg-gradient-to-r from-gold-500/20 to-gold-400/10 rounded-full blur-3xl animate-pulse-slow"></div>
	<div class="absolute bottom-1/4 right-1/6 w-96 h-96 bg-gradient-to-l from-gold-500/15 to-gold-600/10 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 1.5s;"></div>
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-radial-gold opacity-40"></div>

	<!-- Floating Particles -->
	<div class="particles-container">
		<div class="particle particle-1"></div>
		<div class="particle particle-2"></div>
		<div class="particle particle-3"></div>
		<div class="particle particle-4"></div>
		<div class="particle particle-5"></div>
		<div class="particle particle-6"></div>
	</div>

	<!-- Floating Icons with Glow -->
	<div class="absolute top-28 left-16 animate-float-glow hidden md:block">
		<div class="icon-wrapper">
			<Briefcase class="w-14 h-14 text-gold-500" />
		</div>
	</div>
	<div class="absolute top-36 right-24 animate-float-glow hidden md:block" style="animation-delay: 0.7s;">
		<div class="icon-wrapper">
			<Users class="w-11 h-11 text-gold-400" />
		</div>
	</div>
	<div class="absolute bottom-36 left-1/4 animate-float-glow hidden md:block" style="animation-delay: 1.2s;">
		<div class="icon-wrapper">
			<TrendingUp class="w-12 h-12 text-gold-500" />
		</div>
	</div>
	<div class="absolute bottom-44 right-16 animate-float-glow hidden md:block" style="animation-delay: 1.8s;">
		<div class="icon-wrapper">
			<Lightbulb class="w-10 h-10 text-gold-400" />
		</div>
	</div>
	<div class="absolute top-1/2 left-8 animate-float-glow hidden lg:block" style="animation-delay: 2.2s;">
		<div class="icon-wrapper">
			<Target class="w-9 h-9 text-gold-500" />
		</div>
	</div>
	<div class="absolute top-1/3 right-8 animate-float-glow hidden lg:block" style="animation-delay: 0.4s;">
		<div class="icon-wrapper">
			<Rocket class="w-10 h-10 text-gold-400" />
		</div>
	</div>

	<div class="container mx-auto px-6 py-20 relative z-10">
		<div class="max-w-4xl mx-auto text-center space-y-8">
			<!-- Badge -->
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gold-500/10 border border-gold-500/30 animate-fade-in">
				<Sparkles class="w-4 h-4 text-gold-400" />
				<span class="text-sm font-medium text-gold-400 tracking-wide">Serviços Premium</span>
			</div>
			
			<!-- Title with Shimmer Effect -->
			<h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight animate-fade-in" style="animation-delay: 0.1s;">
				<span class="text-white block">Soluções Multidisciplinares</span>
				<span class="shimmer-text block mt-2">para Impulsionar o Crescimento</span>
				<span class="text-white block mt-2">da Sua Empresa</span>
			</h1>
			
			<!-- Decorative Separator -->
			<div class="flex items-center justify-center gap-4 animate-fade-in" style="animation-delay: 0.25s;">
				<div class="w-16 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
				<div class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></div>
				<div class="w-16 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
			</div>
			
			<!-- Description with Better Contrast -->
			<p class="text-lg md:text-xl text-gray-200 max-w-3xl mx-auto leading-relaxed animate-fade-in" style="animation-delay: 0.3s;">
				Consultoria estratégica, inovação digital, desenvolvimento organizacional e apoio técnico para empresas, governos e instituições que procuram 
				<span class="text-gold-400 font-medium">resultados concretos e sustentáveis</span>.
			</p>
			
			<!-- CTA Buttons with Enhanced Glow -->
			<div class="flex flex-col sm:flex-row gap-4 justify-center pt-6 animate-fade-in" style="animation-delay: 0.5s;">
				<a href="/proposta" class="group relative px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600 text-dark-200 font-semibold text-lg shadow-glow-gold hover:shadow-glow-gold-lg transition-all duration-300 transform hover:scale-105 overflow-hidden">
					<span class="relative z-10 flex items-center justify-center gap-2">
						Solicitar Proposta
						<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
						</svg>
					</span>
					<div class="absolute inset-0 bg-gradient-to-r from-gold-500 to-gold-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					<div class="btn-shine"></div>
				</a>
				<a href="/contact" class="group px-8 py-4 rounded-xl border-2 border-gold-500/50 text-gold-400 font-semibold text-lg hover:bg-gold-500/15 hover:border-gold-500 hover:text-gold-300 transition-all duration-300 transform hover:scale-105 backdrop-blur-sm">
					<span class="flex items-center justify-center gap-2">
						Fale com um Consultor
						<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
						</svg>
					</span>
				</a>
			</div>
			
			<!-- Trust Indicators -->
			<div class="flex flex-wrap items-center justify-center gap-6 pt-8 animate-fade-in" style="animation-delay: 0.7s;">
				<div class="flex items-center gap-2 text-gray-400 text-sm">
					<svg class="w-5 h-5 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
					<span>+150 Projetos</span>
				</div>
				<div class="flex items-center gap-2 text-gray-400 text-sm">
					<svg class="w-5 h-5 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
					<span>Equipa Multidisciplinar</span>
				</div>
				<div class="flex items-center gap-2 text-gray-400 text-sm">
					<svg class="w-5 h-5 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
					<span>Resultados Comprovados</span>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Bottom Gradient Fade -->
	<div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-dark-200 to-transparent"></div>
</section>

<style>
	/* Radial Gold Gradient */
	.bg-radial-gold {
		background: radial-gradient(circle, rgba(255, 184, 0, 0.12) 0%, transparent 70%);
	}

	/* Shimmer Text Effect */
	.shimmer-text {
		background: linear-gradient(
			90deg,
			#FFB800 0%,
			#FFD54D 25%,
			#FFB800 50%,
			#CC9300 75%,
			#FFB800 100%
		);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: shimmer 3s ease-in-out infinite;
	}

	@keyframes shimmer {
		0%, 100% { background-position: 200% 50%; }
		50% { background-position: 0% 50%; }
	}

	/* Fade In Animation */
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(25px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	.animate-fade-in {
		animation: fade-in 0.8s ease-out forwards;
		opacity: 0;
	}

	/* Float with Glow Animation */
	@keyframes float-glow {
		0%, 100% {
			transform: translateY(0px);
			filter: drop-shadow(0 0 8px rgba(255, 184, 0, 0.3));
		}
		50% {
			transform: translateY(-15px);
			filter: drop-shadow(0 0 16px rgba(255, 184, 0, 0.5));
		}
	}
	
	.animate-float-glow {
		animation: float-glow 5s ease-in-out infinite;
	}

	/* Icon Wrapper with Glow */
	.icon-wrapper {
		padding: 12px;
		border-radius: 16px;
		background: rgba(255, 184, 0, 0.08);
		border: 1px solid rgba(255, 184, 0, 0.2);
		backdrop-filter: blur(8px);
		transition: all 0.3s ease;
	}

	.icon-wrapper:hover {
		background: rgba(255, 184, 0, 0.15);
		border-color: rgba(255, 184, 0, 0.4);
		box-shadow: 0 0 30px rgba(255, 184, 0, 0.3);
	}

	/* Slow Pulse Animation */
	.animate-pulse-slow {
		animation: pulse-slow 4s ease-in-out infinite;
	}

	@keyframes pulse-slow {
		0%, 100% { opacity: 0.4; transform: scale(1); }
		50% { opacity: 0.7; transform: scale(1.05); }
	}

	/* Button Shine Effect */
	.btn-shine {
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.2),
			transparent
		);
		animation: btn-shine 3s infinite;
	}

	@keyframes btn-shine {
		0% { left: -100%; }
		50%, 100% { left: 100%; }
	}

	/* Floating Particles */
	.particles-container {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.particle {
		position: absolute;
		width: 4px;
		height: 4px;
		background: linear-gradient(135deg, #FFB800, #FFD54D);
		border-radius: 50%;
		opacity: 0.6;
		animation: particle-float 8s ease-in-out infinite;
	}

	.particle-1 { top: 20%; left: 10%; animation-delay: 0s; }
	.particle-2 { top: 60%; left: 85%; animation-delay: 1s; }
	.particle-3 { top: 80%; left: 20%; animation-delay: 2s; }
	.particle-4 { top: 30%; left: 70%; animation-delay: 3s; }
	.particle-5 { top: 50%; left: 5%; animation-delay: 4s; }
	.particle-6 { top: 15%; left: 90%; animation-delay: 5s; }

	@keyframes particle-float {
		0%, 100% {
			transform: translate(0, 0) scale(1);
			opacity: 0.6;
		}
		25% {
			transform: translate(20px, -30px) scale(1.2);
			opacity: 0.8;
		}
		50% {
			transform: translate(-10px, -50px) scale(0.8);
			opacity: 0.4;
		}
		75% {
			transform: translate(-20px, -20px) scale(1.1);
			opacity: 0.7;
		}
	}

	/* Shadow Glow Utilities */
	.shadow-glow-gold {
		box-shadow: 0 0 20px rgba(255, 184, 0, 0.3), 0 0 40px rgba(255, 184, 0, 0.15);
	}

	.shadow-glow-gold-lg {
		box-shadow: 0 0 30px rgba(255, 184, 0, 0.4), 0 0 60px rgba(255, 184, 0, 0.25);
	}
</style>
