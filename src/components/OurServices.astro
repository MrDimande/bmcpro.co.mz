---
import { Target, Cpu, Megaphone, Check, ArrowRight, Sparkles } from 'lucide-astro';

// Preview de 3 serviços destacados para a homepage
const services = [
	{
		icon: Target,
		title: 'Consultoria Estratégica',
		slug: 'consultoria-estrategica',
		category: 'strategic',
		description: 'Apoiamos organizações na definição de metas, estratégias e planos de ação alinhados à realidade do mercado e ao futuro desejado pela instituição.',
		features: ['Diagnóstico organizacional', 'Planeamento estratégico', 'Gestão de performance']
	},
	{
		icon: Cpu,
		title: 'Inovação Digital & Smart Solutions',
		slug: 'inovacao-digital',
		category: 'digital',
		description: 'Integramos ferramentas tecnológicas que aceleram processos, melhoram decisões e trazem eficiência às operações.',
		features: ['Digitalização de processos', 'Soluções de georreferenciação', 'Web development e sistemas']
	},
	{
		icon: Megaphone,
		title: 'Comunicação & Branding',
		slug: 'comunicacao-branding',
		category: 'communication',
		description: 'Criamos identidade visual, campanhas e materiais que reforçam a presença das marcas e facilitam a comunicação com o público-alvo.',
		features: ['Identidade visual e branding', 'Gestão de redes sociais', 'Estratégias de comunicação']
	}
];

// Cores por categoria
const categoryColors: Record<string, { from: string; to: string; glow: string }> = {
	strategic: { from: 'from-amber-500/30', to: 'to-amber-600/10', glow: 'rgba(245, 158, 11, 0.4)' },
	digital: { from: 'from-blue-500/30', to: 'to-blue-600/10', glow: 'rgba(59, 130, 246, 0.4)' },
	communication: { from: 'from-purple-500/30', to: 'to-purple-600/10', glow: 'rgba(168, 85, 247, 0.4)' },
};
---

<section id="services" class="py-20 relative overflow-hidden">
	<div class="container mx-auto px-6 relative z-10">
		<!-- Header Premium -->
		<header class="text-center mb-16 animate-on-scroll">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full badge-premium mb-6">
				<Sparkles class="w-4 h-4 text-gold-500" stroke-width="2" />
				<span class="text-sm font-semibold text-gold-400">Soluções Integradas</span>
			</div>
			
			<h2 class="text-4xl md:text-5xl font-bold mb-4">
				<span class="text-white">Os Nossos </span>
				<span class="gradient-text-animated">Serviços</span>
			</h2>
			
			<p class="text-gray-300 text-lg max-w-2xl mx-auto">
				Explore algumas das nossas áreas de especialização
			</p>
		</header>

		<div class="grid md:grid-cols-3 gap-8">
			{services.map((service, index) => {
				const IconComponent = service.icon;
				const colors = categoryColors[service.category];
				
				return (
					<article 
						class="parallax-card-wrapper animate-on-scroll group" 
						style={`--animation-delay: ${index * 0.15}s`}
						aria-labelledby={`home-service-${service.slug}`}
					>
						<div class="card-metallic card-glow-border shimmer-border rounded-3xl p-8 transition-all duration-300 transform hover:-translate-y-1 hover:scale-[1.02] h-full flex flex-col">
							<!-- Ícone com gradiente único -->
							<div 
								class={`w-20 h-20 rounded-2xl bg-gradient-to-br ${colors.from} ${colors.to} flex items-center justify-center mb-6 mx-auto transition-all duration-300`}
								style={`box-shadow: 0 0 20px ${colors.glow};`}
							>
								<IconComponent class="w-10 h-10 text-gold-500 icon-pulse" stroke-width="1.5" />
							</div>
							
							<h3 
								id={`home-service-${service.slug}`}
								class="text-2xl font-bold text-gold-500 mb-4 text-center group-hover:text-gold-400 transition-colors"
							>
								{service.title}
							</h3>
							
							<p class="text-gray-200 leading-relaxed text-center text-sm mb-4 flex-grow">
								{service.description}
							</p>
							
							<ul role="list" class="space-y-2 mb-6" aria-label={`Características de ${service.title}`}>
								{service.features.map((feature) => (
									<li class="text-gray-200 text-sm flex items-center gap-2">
										<Check class="w-4 h-4 text-gold-500 flex-shrink-0" stroke-width="2.5" />
										<span>{feature}</span>
									</li>
								))}
							</ul>
							
							<a 
								href={`/servicos/${service.slug}`}
								class="mt-auto w-full px-6 py-3 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-semibold hover:glow-gold-lg transition-all transform hover:scale-[1.02] text-center flex items-center justify-center gap-2 group/btn"
								aria-label={`Saiba mais sobre ${service.title}`}
							>
								<span>Saiba mais</span>
								<ArrowRight class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" stroke-width="2.5" />
							</a>
						</div>
					</article>
				);
			})}
		</div>
		
		<!-- CTA para ver todos os serviços -->
		<div class="text-center mt-12 animate-on-scroll" style="--animation-delay: 0.5s">
			<a 
				href="/services" 
				class="inline-flex items-center gap-2 px-8 py-4 rounded-xl border-2 border-gold-500/50 text-gold-500 font-semibold text-lg hover:bg-gold-500/10 hover:border-gold-500 transition-all transform hover:scale-105"
			>
				Ver Todos os Serviços
				<ArrowRight class="w-5 h-5" stroke-width="2" />
			</a>
		</div>
	</div>
</section>
