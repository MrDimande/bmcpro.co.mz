---
import { ChevronDown } from 'lucide-astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="py-20 bg-dark-300/30 border-t border-white/5">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 class="text-3xl font-bold text-white mb-12 text-center">Perguntas Frequentes</h2>
    
    <div class="space-y-4">
      {items.map((item, index) => (
        <details class="group bg-dark-200 rounded-xl border border-white/5 open:border-gold-500/30 transition-all duration-300">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none text-lg font-medium text-white group-hover:text-gold-500 transition-colors">
            {item.question}
            <ChevronDown class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-300 group-open:text-gold-500" />
          </summary>
          <div class="px-6 pb-6 text-gray-400 leading-relaxed border-t border-white/5 pt-4 group-open:animate-slide-down">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  @keyframes slide-down {
    0% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .group-open\:animate-slide-down {
    animation: slide-down 0.3s ease-out forwards;
  }
</style>
