---
interface TimelineStep {
  title: string;
  description: string;
}

interface Props {
  steps: TimelineStep[];
  title?: string;
  subtitle?: string;
}

const { steps, title = "A Nossa Metodologia", subtitle = "Um processo testado e transparente" } = Astro.props;
---

<section class="py-24 relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
      <p class="text-gray-400">{subtitle}</p>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical Line -->
      <div class="absolute left-[20px] md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-transparent via-gold-500/30 to-transparent transform md:-translate-x-1/2"></div>

      <div class="space-y-12">
        {steps.map((step, index) => (
          <div class={`relative flex items-center md:justify-between ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            
            <!-- Content -->
            <div class={`ml-12 md:ml-0 md:w-[45%] ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
              <div class="p-6 rounded-2xl glass-dark border border-white/5 hover:border-gold-500/30 transition-all duration-300 group">
                <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">
                  Fase {index + 1}
                </span>
                <h3 class="text-xl font-bold text-white mb-3 group-hover:text-gold-400 transition-colors">
                  {step.title}
                </h3>
                <p class="text-gray-400 text-sm leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>

            <!-- Dot -->
            <div class="absolute left-0 md:left-1/2 w-10 h-10 rounded-full bg-dark-100 border-4 border-dark-300 flex items-center justify-center transform md:-translate-x-1/2 z-10 shadow-lg shadow-black/50">
              <div class="w-3 h-3 bg-gold-500 rounded-full animate-pulse"></div>
            </div>

            <!-- Spacer -->
            <div class="hidden md:block md:w-[45%]"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .glass-dark {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
  }
</style>
