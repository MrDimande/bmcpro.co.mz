---
import Layout from '../../layouts/Layout.astro';

---

<Layout title="Candidatura Recebida | BMC Pro Services">
  <main class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-6 lg:px-8">
    <div class="max-w-md w-full text-center">
         <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-green-100 mb-8">
            <svg class="h-12 w-12 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          
          <h1 class="text-3xl font-bold tracking-tight text-gray-900">Candidatura Recebida!</h1>
          <p class="mt-4 text-lg text-gray-600">
            Agradecemos o seu interesse em fazer parte da equipa BMC Pro Services. Recebemos os seus dados e iremos analisar o seu perfil.
          </p>
          <p class="mt-2 text-base text-gray-500">
            Entraremos em contacto caso o seu perfil corresponda aos requisitos da vaga.
          </p>
          
          <div class="mt-10 flex items-center justify-center gap-x-6">
            <a href="/" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
              Ir para a página inicial
            </a>
            <a href="/recrutamento/vagas" class="text-sm font-semibold leading-6 text-gray-900">
              Ver outras vagas <span aria-hidden="true">→</span>
            </a>
          </div>
    </div>
  </main>
</Layout>
