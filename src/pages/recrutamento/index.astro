---
import Layout from '../../layouts/Layout.astro';

---

<Layout title="Recrutamento | BMC Pro Services">
  <main class="min-h-screen bg-gray-50">
    <div class="relative bg-dark-200 py-24 sm:py-32">
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
        </div>
        <div class="relative mx-auto max-w-7xl px-6 lg:px-8 text-center">
            <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">Junte-se à nossa equipa</h1>
            <p class="mt-6 text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
                Na BMC Pro Services, procuramos talentos que queiram fazer a diferença. Oferecemos um ambiente de crescimento, inovação e desafios constantes.
            </p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
                <a href="/recrutamento/vagas" class="rounded-md bg-gold-500 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gold-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 transition-colors">
                    Ver Vagas Disponíveis
                </a>
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-24">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
             <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
                <div class="w-12 h-12 bg-gold-100 rounded-lg flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-gold-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Inovação Constante</h3>
                <p class="text-gray-600">Trabalhe com tecnologias de ponta e metodologias ágeis em projetos desafiadores.</p>
            </div>
             <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
                <div class="w-12 h-12 bg-gold-100 rounded-lg flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-gold-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.499 5.516 50.552 50.552 0 00-2.658.813m-15.482 0A50.553 50.553 0 0112 20.904a50.553 50.553 0 0111.966-9.943m-15.482 0C2.527 10.518 1.996 9.873 1.5 9.176l-.11-.128M22.5 9.176c-.496.697-1.027 1.342-1.583 1.638" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Crescimento Profissional</h3>
                <p class="text-gray-600">Programas de mentoria e orçamento para cursos e certificações.</p>
            </div>
             <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
                <div class="w-12 h-12 bg-gold-100 rounded-lg flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-gold-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Cultura Colaborativa</h3>
                <p class="text-gray-600">Ambiente inclusivo onde todas as voz são ouvidas e respeitadas.</p>
            </div>
        </div>
    </div>
  </main>
</Layout>
