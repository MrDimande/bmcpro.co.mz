---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { ShoppingBag, ShieldCheck, Truck, BarChart, Gavel, ArrowRight, Phone, Mail, ChevronLeft, Handshake, FileCheck, AlertTriangle } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Procurement e Gestão de Aquisições',
	ref: 'Procurement',
	problem: 'Compras ineficientes drenam até 20% do orçamento operacional. A falta de transparência, fornecedores não qualificados e processos lentos transformam o departamento de compras num gargalo burocrático, em vez de uma alavanca estratégica de lucro.',
	approach: 'Procurement não é apenas "pedir três cotações". É a gestão estratégica da cadeia de fornecimento. Implementamos processos blindados que garantem compliance (essencial para Oil & Gas e Doadores) e negociamos baseados no Custo Total de Propriedade (TCO), não apenas no preço de etiqueta.',
	outputs: [
		{ title: 'Manual de Procurement', desc: 'Procedimentos Operacionais Padrão (SOPs) para aquisições.' },
		{ title: 'Vendor List Qualificada', desc: 'Base de dados de fornecedores auditados e confiáveis.' },
		{ title: 'Gestão de Contratos', desc: 'Monitoria de SLAs e desempenho de fornecedores.' },
		{ title: 'Auditorias de Compliance', desc: 'Verificação de conformidade para evitar conflitos de interesse.' }
	],
	tools: [
		'Sistemas e-Procurement (SAP Ariba / Coupa)',
		'Ferramentas de Avaliação de Fornecedores de Risco',
		'Matriz de Kraljic para Estratégia de Compras',
		'Dashboards de Spend Analysis'
	],
	caseStudy: {
		title: 'Optimização de Custos em Projecto',
		scenario: 'Um projecto financiado internacionalmente tinha custos de aprovisionamento 30% acima da média de mercado e sofria com constantes auditorias negativas devido a falhas processuais.',
		result: 'Centralizámos as compras, negociámos contratos-quadro anuais e implementámos um sistema de aprovação digital. Em 6 meses, a poupança foi de USD 150.000 e o projecto obteve a primeira auditoria "Clean" em 3 anos.'
	}
};

const pros = ["Projectos financiados por doadores (WB, USAID, UE)", "Empresas com alto volume de compras recorrentes", "Organizações que falharam auditorias recentes"];
const cons = ["Pequenas empresas com compras esporáquicas", "Quem busca 'esquemas' ou falta de transparência"];

const methodologySteps = [
    { title: "Spend Analysis", description: "Analisamos onde e como gasta o seu dinheiro." },
    { title: "Estratégia de Sourcing", description: "Definimos como comprar cada categoria (Matriz Kraljic)." },
    { title: "Selecção de Fornecedores", description: "RFI, RFP e negociação agressiva mas justa." },
    { title: "Contratualização (SLA)", description: "Garantias legais e níveis de serviço claros." },
    { title: "Performance Review", description: "Avaliação contínua dos fornecedores trimestralmente." }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Gestão de aprovisionamento, compras estratégicas e supply chain."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<!-- Hero Section -->
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<ShoppingBag class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Procurement </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							& Gestão de Aquisições
						</span>
					</h1>
				</div>
			</div>
		</section>

        <!-- Risk Matrix Section -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
            <div class="container mx-auto px-6">
                 <div class="text-center mb-10">
                     <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">Gestão de Risco</span>
                     <h2 class="text-3xl font-bold text-white mb-2">Matriz de Avaliação de Fornecedores</h2>
                     <p class="text-gray-400">Não olhamos só para o preço. Avaliamos o risco oculto.</p>
                 </div>

                 <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8 items-center">
                     <div class="relative bg-dark-200 p-8 rounded-2xl border border-white/5 shadow-2xl">
                         <!-- Matrix Visual -->
                         <div class="relative aspect-square border-l-2 border-b-2 border-gray-600">
                             <div class="absolute -left-8 top-1/2 -rotate-90 text-xs font-bold text-gray-400">Confiabilidade</div>
                             <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs font-bold text-gray-400">Preço</div>

                             <!-- Quadrants -->
                             <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-1 p-1">
                                 <div class="bg-red-500/20 rounded flex items-center justify-center text-red-500 text-xs font-bold p-2 text-center">
                                     Barato mas Arriscado
                                 </div>
                                 <div class="bg-green-500/20 rounded flex items-center justify-center text-green-500 text-xs font-bold p-2 text-center border-2 border-gold-500 shadow-[0_0_20px_rgba(234,179,8,0.3)]">
                                     Parceiro Ideal (BMC Target)
                                 </div>
                                 <div class="bg-gray-700/20 rounded flex items-center justify-center text-gray-500 text-xs font-bold p-2 text-center">
                                     Evitar
                                 </div>
                                 <div class="bg-yellow-500/20 rounded flex items-center justify-center text-yellow-500 text-xs font-bold p-2 text-center">
                                     Caro mas Seguro
                                 </div>
                             </div>
                             
                             <!-- Scatter Plot Dots -->
                             <div class="absolute top-[20%] right-[20%] w-3 h-3 bg-white rounded-full shadow-lg"></div>
                             <div class="absolute top-[30%] right-[30%] w-3 h-3 bg-white rounded-full shadow-lg opacity-50"></div>
                             <div class="absolute bottom-[20%] left-[20%] w-3 h-3 bg-red-500 rounded-full shadow-lg"></div>
                         </div>
                     </div>
                     
                     <div class="space-y-6">
                         <div class="flex items-start gap-4">
                             <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-500 font-bold shrink-0">1</div>
                             <div>
                                 <h4 class="text-white font-bold text-lg">Compliance Check</h4>
                                 <p class="text-gray-400 text-sm">Validamos regularidade fiscal, licenças e historial legal.</p>
                             </div>
                         </div>
                         <div class="flex items-start gap-4">
                             <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-500 font-bold shrink-0">2</div>
                             <div>
                                 <h4 class="text-white font-bold text-lg">Capacidade Técnica</h4>
                                 <p class="text-gray-400 text-sm">Verificamos se o fornecedor consegue entregar o volume prometido.</p>
                             </div>
                         </div>
                         <div class="flex items-start gap-4">
                             <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-500 font-bold shrink-0">3</div>
                             <div>
                                 <h4 class="text-white font-bold text-lg">Sustentabilidade</h4>
                                 <p class="text-gray-400 text-sm">Alinhamento com práticas ESG e ética laboral.</p>
                             </div>
                         </div>
                     </div>
                 </div>
            </div>
        </section>

		<!-- 1. O Problema Real -->
		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<Gavel class="w-5 h-5" />
						Transparência Total
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps}
            title="Ciclo de Compras Seguro"
            subtitle="Processos auditáveis em todas as etapas."
        />

		<!-- 3. O Que Entregamos (Outputs) -->
		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<FileCheck class="w-5 h-5" />
					Entregáveis de Compliance
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<ShieldCheck class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<!-- 5. Mini-caso (Cenário Real) -->
		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<BarChart class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Poupança Real</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						Quer garantir que está a comprar bem?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Audite o seu procurement e blinde a sua operação contra riscos e ineficiências.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Solicitar Auditoria de Compras
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
</style>
