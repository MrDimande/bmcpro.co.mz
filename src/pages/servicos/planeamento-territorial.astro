---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Map, Home, Compass, Layers, Calculator, ArrowRight, Phone, Mail, ChevronLeft, MapPin, Grid, AlertTriangle, Leaf, Users } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Planeamento Territorial',
	ref: 'Território',
	problem: 'O crescimento urbano desordenado gera caos, conflitos de terra e insegurança jurídica. Investir em terrenos sem situação regularizada (DUAT) ou construir sem planeamento infra-estrutural é um risco que pode custar milhões em litígios ou demolições.',
	approach: 'Unimos o rigor da engenharia à visão urbanística humanizada. Não desenhamos apenas loteamentos; projectamos comunidades funcionais. A nossa abordagem garante segurança jurídica total (Due Diligence Fundiária) e viabilidade técnica, valorizando cada metro quadrado do seu activo.',
	outputs: [
		{ title: 'Planos de Pormenor', desc: 'Planeamento urbano detalhado (PEU/PPU) aprovado municipalmente.' },
		{ title: 'Regularização de DUAT', desc: 'Tratamento processual completo para titularidade de terra.' },
		{ title: 'Parcelamentos', desc: 'Projectos de loteamento com demarcação topográfica de precisão.' },
		{ title: 'Masterplans', desc: 'Concepção macro para condomínios, parques industriais e turísticos.' }
	],
	tools: [
		'AutoCAD Civil 3D (Projecto de Infra-estruturas)',
		'ArcGIS Pro (Análise Espacial e Planeamento)',
		'Drones RTK (Topografia Aérea de Alta Precisão)',
		'GPS Geodésico de Dupla Frequência'
	],
	caseStudy: {
		title: 'Reassentamento Urbano Modelo',
		scenario: 'Um grande projecto de infra-estrutura exigia o reassentamento de 200 famílias, com elevado risco de tensão social e rejeição comunitária.',
		result: 'Desenhámos um bairro modelo com processo participativo. A comunidade ajudou a definir arruamentos e serviços. Resultado: 100% de adesão voluntária e o bairro tornou-se referência municipal de planeamento inclusivo.'
	}
};

const pros = ["Governos e Municípios que querem ordenar o território", "Investidores imobiliários (Real Estate Developers)", "Empresas mineiras/industriais a necessitar de DUATs", "Donos de grandes extensões de terra"];
const cons = ["Quem procura legalização de terras em zonas de protecção total", "Projectos informais sem intenção de cumprir a lei"];

const methodologySteps = [
    { title: "Levantamento", description: "Topografia com Drones e GPS para conhecer o terreno real." },
    { title: "Estudos de Base", description: "Análise ambiental, legal e social da área." },
    { title: "Concepção Urbanística", description: "Desenho da estrutura, arruamentos, zonas verdes e lotes." },
    { title: "Licenciamento", description: "Tramitação junto das autoridades municipais e nacionais." },
    { title: "Demarcação Física", description: "Colocação de marcos físicos no terreno." }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Urbanismo, topografia e regularização fundiária em Moçambique."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<!-- Hero Section -->
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Map class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Planeamento </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Territorial
						</span>
					</h1>
				</div>
			</div>
		</section>

        <!-- Interactive Map Mockup Section -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
             <div class="container mx-auto px-6">
                 <div class="text-center mb-10">
                     <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">Tecnologia GIS</span>
                     <h2 class="text-3xl font-bold text-white mb-2">Visão Multicamada</h2>
                     <p class="text-gray-400">Tomamos decisões baseadas em dados espaciais sobrepostos.</p>
                 </div>
                 
                 <div class="grid md:grid-cols-2 gap-12 items-center">
                     <!-- Map Visualization -->
                     <div class="relative aspect-square md:aspect-video rounded-2xl overflow-hidden shadow-2xl group border border-white/10">
                         <!-- Base Map -->
                         <div class="absolute inset-0 bg-neutral-800 flex items-center justify-center">
                              <div class="text-gray-600 font-mono text-xs grid grid-cols-6 gap-4 opacity-20 w-full h-full p-4">
                                  {Array(24).fill(0).map(() => <div class="border border-gray-500 rounded"></div>)}
                              </div>
                         </div>
                         
                         <!-- Layers (simulated) -->
                         <div class="absolute inset-0 bg-blue-500/10 mix-blend-overlay transition-opacity duration-500 opacity-100" id="layer-water"></div> <!-- Water/Hydro -->
                         <div class="absolute inset-0 bg-green-500/10 mix-blend-overlay transition-opacity duration-500 opacity-60" id="layer-veg"></div> <!-- Veg -->
                         <div class="absolute inset-0 transition-opacity duration-500 opacity-80 flex items-center justify-center" id="layer-risk">
                             <div class="w-32 h-32 bg-red-500/20 blur-2xl rounded-full"></div> 
                         </div>

                         <!-- UI Overlay -->
                         <div class="absolute bottom-4 right-4 bg-dark-200/90 backdrop-blur p-4 rounded-xl border border-white/10 text-xs text-white space-y-2">
                             <div class="flex items-center gap-2"><div class="w-3 h-3 bg-red-500 rounded-full"></div> Risco de Cheias</div>
                             <div class="flex items-center gap-2"><div class="w-3 h-3 bg-green-500 rounded-full"></div> Zona Protegida</div>
                             <div class="flex items-center gap-2"><div class="w-3 h-3 bg-blue-500 rounded-full"></div> Hidrografia</div>
                         </div>
                     </div>

                     <!-- Scenarios -->
                     <div class="space-y-6">
                         <h3 class="text-2xl font-bold text-white mb-4">Simulação de Cenários</h3>
                         
                         <div class="p-6 rounded-xl bg-dark-200 border border-white/5 hover:border-gold-500/50 transition-colors cursor-default group/card">
                             <div class="flex items-center justify-between mb-2">
                                 <span class="text-gold-500 font-bold">Cenário A: Crescimento Natural</span>
                                 <Users class="w-5 h-5 text-gray-500 group-hover/card:text-gold-500 transition-colors" />
                             </div>
                             <p class="text-gray-400 text-sm">Se a população aumentar 3% ao ano, as infra-estruturas actuais colapsam em 2028.</p>
                         </div>

                         <div class="p-6 rounded-xl bg-dark-200 border border-white/5 hover:border-green-500/50 transition-colors cursor-default group/card">
                             <div class="flex items-center justify-between mb-2">
                                 <span class="text-green-500 font-bold">Cenário B: Planeado (BMC Pro)</span>
                                 <Leaf class="w-5 h-5 text-gray-500 group-hover/card:text-green-500 transition-colors" />
                             </div>
                             <p class="text-gray-400 text-sm">Com zoneamento misto e drenagem adequada, a área suporta +150% de densidade com qualidade de vida.</p>
                         </div>
                         
                         <div class="p-6 rounded-xl bg-dark-200 border border-white/5 hover:border-red-500/50 transition-colors cursor-default group/card">
                             <div class="flex items-center justify-between mb-2">
                                 <span class="text-red-500 font-bold">Cenário C: Ocupação Espontânea</span>
                                 <AlertTriangle class="w-5 h-5 text-gray-500 group-hover/card:text-red-500 transition-colors" />
                             </div>
                             <p class="text-gray-400 text-sm">Risco elevado de assentamentos em zonas de cheia e custo de regularização futura 10x maior.</p>
                         </div>
                     </div>
                 </div>
             </div>
        </section>

		<!-- 1. O Problema Real -->
		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<MapPin class="w-5 h-5" />
						O Caos Urbano
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps} 
            title="Do Levantamento ao Título"
            subtitle="Processo seguro e técnico."
        />

		<!-- 3. O Que Entregamos (Outputs) -->
		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<Grid class="w-5 h-5" />
					Entregáveis Técnicos
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Layers class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <!-- Pros and Cons -->
        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<!-- 5. Mini-caso (Cenário Real) -->
		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<Home class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Comunidade Viva</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						O seu terreno está seguro?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Não corra riscos de litígios. Garanta a legalidade e a valorização do seu património imobiliário.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Consultar Situação Fundiária
							<ArrowRight class="w-5 h-5" />
						</a>
						<a href="/contact" class="px-8 py-4 rounded-xl border border-white/10 hover:bg-white/5 text-white font-medium transition-all flex items-center gap-2">
							Pedir Estudo de Topografia
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
</style>
