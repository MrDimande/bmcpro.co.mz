---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Target, TrendingUp, BarChart, Users, Zap, ArrowRight, Phone, Mail, ChevronLeft, Compass, LineChart, PieChart, Layers } from 'lucide-astro';
import InteractiveQuiz from '../../components/services/InteractiveQuiz';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Consultoria Estratégica',
	ref: 'Estratégia',
	problem: 'Estudos indicam que 70% das estratégias falham na execução. Muitas empresas têm "Visão" e "Missão" na parede, mas operam no caos diário, desperdiçando recursos em iniciativas desconectadas e reagindo ao mercado em vez de o liderar.',
	approach: 'Não entregamos "relatórios de gaveta". Co-criamos a estratégia com a liderança e, crucialmente, desenhamos o sistema de execução. Traduzimos ambições abstractas em acções tangíveis e métricas diárias, garantindo alinhamento vertical e horizontal na organização.',
	outputs: [
		{ title: 'Mapa Estratégico', desc: 'Balanced Scorecard traduzindo visão em eixos de actuação.' },
		{ title: 'Matriz de Decisão', desc: 'Framework para priorização de investimentos e projectos.' },
		{ title: 'Dashboard de KPIs', desc: 'Painel de controlo executivo para monitoria em tempo real.' },
		{ title: 'Plano de Mudança', desc: 'Roteiro de gestão de mudança cultural e organizacional.' }
	],
	tools: [
		'Análise SWOT / PESTEL Dinâmica',
		'Business Model Canvas',
		'Metodologia OKRs (Objectives and Key Results)',
		'Cenários Prospectivos'
	],
	caseStudy: {
		title: 'Reviravolta no Sector Logístico',
		scenario: 'Uma empresa de logística nacional estagnada há 3 anos estava a perder quota de mercado agressivamente para concorrentes internacionais.',
		result: 'Redefinimos o posicionamento estratégico para focar em nichos de "Last Mile" de alta complexidade. Em 12 meses, a margem líquida cresceu 40% e a retenção de clientes chave subiu para 95%.'
	}
};

const quizQuestions = [
  { id: 1, text: "A sua empresa tem metas claras para os próximos 3 anos?", options: [{ text: "Sim, e todos conhecem", points: 2 }, { text: "Sim, mas só a gestão sabe", points: 1 }, { text: "Não, vivemos o dia-a-dia", points: 0 }] },
  { id: 2, text: "Como toma decisões de investimento importantes?", options: [{ text: "Baseado em dados e estratégia", points: 2 }, { text: "Intuição da liderança", points: 1 }, { text: "Reagindo a urgências", points: 0 }] },
  { id: 3, text: "A sua equipa sabe como o trabalho dela impacta os resultados?", options: [{ text: "Sim, temos KPIs individuais", points: 2 }, { text: "Vagamente", points: 1 }, { text: "Não", points: 0 }] },
  { id: 4, text: "Com que frequência revisa a sua estratégia?", options: [{ text: "Trimestralmente", points: 2 }, { text: "Anualmente", points: 1 }, { text: "Nunca / Quando há crise", points: 0 }] },
  { id: 5, text: "Conhece profundamente os seus concorrentes e clientes?", options: [{ text: "Sim, temos pesquisas recentes", points: 2 }, { text: "Temos uma noção geral", points: 1 }, { text: "Não focamos nisso", points: 0 }] }
];

const quizResults = [
  { minScore: 0, maxScore: 4, title: "Modo Sobrevivência", description: "A sua empresa está a reagir ao mercado em vez de o liderar. O risco de estagnação é alto. Precisa urgentemente de um alinhamento estratégico básico.", color: "bg-red-500" },
  { minScore: 5, maxScore: 7, title: "Em Crescimento, Mas Desalinhado", description: "Tem boas intenções e alguma visão, mas falha na execução e consistência. Profissionalizar a gestão estratégica será o catalisador para o próximo nível.", color: "bg-yellow-500" },
  { minScore: 8, maxScore: 10, title: "Líder Estratégico", description: "Excelente! A sua organização tem maturidade. Podemos ajudar a afinar a inovação e explorar novos oceanos azuis.", color: "bg-green-500" }
];

const methodologySteps = [
  { title: "Diagnóstico Profundo", description: "Mergulhamos na sua realidade: entrevistas, análise financeira e auditoria de processos." },
  { title: "Co-Criação da Visão", description: "Workshops com a liderança para definir 'Onde Queremos Estar' e 'Como Vamos Ganhar'." },
  { title: "Design do Sistema de Execução", description: "Criação de Mapas Estratégicos, KPIs e rituais de gestão (reuniões, reports)." },
  { title: "Desdobramento & Capacitação", description: "Comunicação da estratégia a toda a equipa e formação chave." },
  { title: "Acompanhamento Guiado", description: "Não vamos embora. Acompanhamos os primeiros ciclos trimestrais de execução." }
];

const pros = ["Empresas em fase de escala ou reestruturação", "Líderes que sentem 'solidão no topo'", "Organizações com baixa produtividade", "Familiar business a profissionalizar-se"];
const cons = ["Quem procura 'dicas rápidas' sem compromisso", "Startups em fase inicial de validação (MVP)", "Empresas que não querem mudar processos"];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Consultoria estratégica e gestão de performance para empresas que querem crescer."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<!-- Hero Section -->
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Target class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Consultoria </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Estratégica
						</span>
					</h1>
				</div>
			</div>
		</section>
        
        <!-- Framework Visualization: BMC-360 Diagram -->
        <section class="py-12 relative">
             <div class="container mx-auto px-6 text-center">
                 <span class="text-gold-500 font-bold tracking-widest uppercase text-sm mb-4 block">O Nosso Framework Exclusivo</span>
                 <h2 class="text-3xl font-bold text-white mb-12">Modelo BMC-360™</h2>
                 
                 <div class="relative max-w-lg mx-auto aspect-square flex items-center justify-center">
                     <!-- This is a creative CSS representation of the framework -->
                     <div class="absolute inset-0 rounded-full border border-white/10 animate-spin-slow"></div>
                     <div class="absolute inset-4 rounded-full border border-gold-500/20"></div>
                     
                     <!-- Center -->
                     <div class="z-20 w-32 h-32 bg-gold-500 rounded-full flex flex-col items-center justify-center shadow-lg shadow-gold-500/30">
                         <span class="font-bold text-dark-100 text-lg">Visão</span>
                         <span class="text-dark-100/70 text-sm">Central</span>
                     </div>

                     <!-- Orbiting Nodes -->
                     <div class="absolute w-24 h-24 bg-dark-300 border border-gold-500/50 rounded-2xl flex flex-col items-center justify-center -top-4 left-1/2 transform -translate-x-1/2 shadow-xl hover:scale-110 transition-transform cursor-default">
                         <Users class="w-6 h-6 text-gold-500 mb-1" />
                         <span class="text-white text-xs font-bold">Pessoas</span>
                     </div>
                     <div class="absolute w-24 h-24 bg-dark-300 border border-gold-500/50 rounded-2xl flex flex-col items-center justify-center bottom-4 left-1/2 transform -translate-x-1/2 shadow-xl hover:scale-110 transition-transform cursor-default">
                         <Layers class="w-6 h-6 text-gold-500 mb-1" />
                         <span class="text-white text-xs font-bold">Processos</span>
                     </div>
                     <div class="absolute w-24 h-24 bg-dark-300 border border-gold-500/50 rounded-2xl flex flex-col items-center justify-center top-1/2 -left-4 transform -translate-y-1/2 shadow-xl hover:scale-110 transition-transform cursor-default">
                         <PieChart class="w-6 h-6 text-gold-500 mb-1" />
                         <span class="text-white text-xs font-bold">Mercado</span>
                     </div>
                     <div class="absolute w-24 h-24 bg-dark-300 border border-gold-500/50 rounded-2xl flex flex-col items-center justify-center top-1/2 -right-4 transform -translate-y-1/2 shadow-xl hover:scale-110 transition-transform cursor-default">
                         <BarChart class="w-6 h-6 text-gold-500 mb-1" />
                         <span class="text-white text-xs font-bold">Financeiro</span>
                     </div>
                 </div>
                 <p class="text-gray-400 mt-12 max-w-2xl mx-auto">
                     A nossa abordagem liga os 4 pilares essenciais: Cultura (Pessoas), Eficiência (Processos), Posicionamento (Mercado) e Sustentabilidade (Financeiro).
                 </p>
             </div>
        </section>

		<!-- 1. O Problema Real -->
		<section class="py-16 relative border-t border-white/5">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<Compass class="w-5 h-5" />
						O Desafio
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>
        
        <!-- Interactive Quiz Section -->
        <section class="py-16 bg-dark-300/20">
            <div class="container mx-auto px-6">
                <div class="text-center mb-10">
                    <h2 class="text-2xl font-bold text-white mb-2">Diagnóstico Estratégico Rápido</h2>
                    <p class="text-gray-400">Em 2 minutos, descubra o nível de maturidade da sua estratégia.</p>
                </div>
                <InteractiveQuiz 
                    client:visible
                    title="Teste de Maturidade Estratégica"
                    description="Responda com honestidade para obter um resultado útil."
                    questions={quizQuestions}
                    results={quizResults}
                />
            </div>
        </section>

		<!-- 2. A Nossa Abordagem (Replaced with Methodology Timeline) -->
        <MethodologyTimeline 
            steps={methodologySteps}
            title="Como Fazemos Acontecer"
            subtitle="Do diagnóstico à execução no terreno."
        />

		<!-- 3. O Que Entregamos (Outputs) -->
		<section class="py-20 relative border-t border-white/5">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<BarChart class="w-5 h-5" />
					Entregáveis Concretos
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Zap class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 4. Ferramentas & Métodos -->
		<section class="py-16 border-y border-white/5 bg-dark-300/30">
			<div class="container mx-auto px-6 text-center">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center justify-center gap-2">
					<Users class="w-5 h-5" />
					Metodologias
				</h2>
				<div class="flex flex-wrap justify-center gap-4 md:gap-8">
					{service.tools.map((tool) => (
						<span class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-gray-300 text-sm md:text-base hover:bg-white/10 transition-colors">
							{tool}
						</span>
					))}
				</div>
			</div>
		</section>
        
        <!-- Pros and Cons -->
        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<!-- 5. Mini-caso (Cenário Real) -->
		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<LineChart class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Crescimento Real</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						A sua equipa sabe o que fazer amanhã?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Acabe com a confusão operacional. Vamos alinhar a sua bússola estratégica para o crescimento.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Agendar Sessão de Diagnóstico
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
    
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 20s linear infinite;
    }
</style>
