---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Briefcase, FolderArchive, Users, Calendar, ArrowRight, Phone, Mail, ChevronLeft, Clock, CheckSquare, FileText, Settings } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Gestão Administrativa & Apoio Operacional',
	ref: 'Gestão',
	problem: 'Muitos gestores de topo perdem 40% do seu tempo em "micro-gestão": assinar papéis, procurar documentos mal arquivados e resolver problemas logísticos menores. Isso mata a estratégia e impede o crescimento do negócio.',
	approach: 'Somos o seu "Back Office as a Service". Assumimos a carga operacional rotineira com processos profissionais, sigilo absoluto e eficiência digital. A sua equipa foca no core business; nós garantimos que a máquina funciona.',
	outputs: [
		{ title: 'Gestão Documental', desc: 'Arquivo físico e digital organizado e indexado.' },
		{ title: 'Secretariado Executivo', desc: 'Gestão de agendas, viagens e correspondência.' },
		{ title: 'Apoio Logístico', desc: 'Gestão de economato, frotas e manutenção de escritório.' },
		{ title: 'Processos Internos', desc: 'Criação de fluxogramas para padronizar operações.' }
	],
	tools: [
		'Office 365 / Google Workspace (Gestão Colaborativa)',
		'Sistemas de Gestão Documental (EDM)',
		'Ferramentas de Gestão de Tarefas (Trello / Asana)',
		'Digitalização OCR'
	],
	caseStudy: {
		title: 'Organização de Escritório de Advogados',
		scenario: 'Uma firma de advogados em crescimento estava afogada em papel e perdia prazos processuais por desorganização administrativa.',
		result: 'Digitalizámos 10 anos de arquivo, implementámos um sistema de agenda partilhada e alocámos uma assistente virtual. A produtividade dos advogados aumentou 20%, resultando em mais horas facturáveis.'
	}
};

const pros = ["PMEs a crescer rápido sem estrutura de RH", "Escritórios de profissionais liberais (Advogados, Médicos)", "Empresas estrangeiras a abrir sucursal em Moçambique"];
const cons = ["Quem precisa de um CEO interino (focamos no suporte)", "Empresas sem orçamento mínimo para outsourcing"];

const methodologySteps = [
    { title: "Levantamento Inicial", description: "Entendemos onde estão os gargalos administrativos." },
    { title: "Organização de Choque", description: "Limpeza, arquivo e estruturação inicial imediata." },
    { title: "Definição de Rotinas", description: "Quem faz o quê, quando e como (SOPs)." },
    { title: "Execução Contínua", description: "Apoio diário/semanal conforme contratado." },
    { title: "Reporte Mensal", description: "Relatório de actividades e ocorrências." }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Outsourcing administrativo, gestão documental e apoio operacional."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Briefcase class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Gestão Administrativa </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							& Apoio Operacional
						</span>
					</h1>
				</div>
			</div>
		</section>

        <!-- Smart Checklist Visualization -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
            <div class="container mx-auto px-6">
                <div class="text-center mb-10">
                    <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">O Invisível Torna-se Visível</span>
                    <h2 class="text-3xl font-bold text-white mb-2">Checklist de Eficiência</h2>
                    <p class="text-gray-400">O que tiramos da sua lista de preocupações hoje?</p>
                </div>
                
                <div class="max-w-3xl mx-auto bg-dark-200 rounded-2xl border border-white/10 overflow-hidden shadow-2xl">
                    <div class="bg-dark-100 p-4 border-b border-white/5 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <div class="text-gray-400 text-sm">Segunda-feira, 08:00 AM</div>
                    </div>
                    <div class="p-8 space-y-4">
                        <div class="flex items-center gap-4 group opacity-50 hover:opacity-100 transition-opacity">
                            <div class="w-6 h-6 rounded border-2 border-green-500 bg-green-500/20 flex items-center justify-center text-green-500">
                                <CheckSquare class="w-4 h-4" />
                            </div>
                            <span class="text-gray-400 line-through decoration-green-500 decoration-2">Confirmar voos e hotel para a Direcção</span>
                        </div>
                        <div class="flex items-center gap-4 group opacity-50 hover:opacity-100 transition-opacity">
                            <div class="w-6 h-6 rounded border-2 border-green-500 bg-green-500/20 flex items-center justify-center text-green-500">
                                <CheckSquare class="w-4 h-4" />
                            </div>
                            <span class="text-gray-400 line-through decoration-green-500 decoration-2">Processar facturas de fornecedores mensais</span>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="w-6 h-6 rounded border-2 border-gold-500 flex items-center justify-center text-transparent">
                                <CheckSquare class="w-4 h-4" />
                            </div>
                            <span class="text-white">Organizar arquivo do Projecto Delta</span>
                            <span class="ml-auto text-xs bg-gold-500/20 text-gold-500 px-2 py-1 rounded">Em curso</span>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="w-6 h-6 rounded border-2 border-gray-600 flex items-center justify-center text-transparent">
                                <CheckSquare class="w-4 h-4" />
                            </div>
                            <span class="text-gray-300">Renovar licenças de software da equipa</span>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="w-6 h-6 rounded border-2 border-gray-600 flex items-center justify-center text-transparent">
                                <CheckSquare class="w-4 h-4" />
                            </div>
                            <span class="text-gray-300">Agenda da reunião de Board</span>
                        </div>
                    </div>
                    <div class="bg-gold-500/10 p-4 text-center border-t border-gold-500/20">
                        <p class="text-gold-500 font-bold">Resultado: 12 horas poupadas esta semana.</p>
                    </div>
                </div>
            </div>
        </section>

		<!-- 1. O Problema Real -->
		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<Clock class="w-5 h-5" />
						O Tempo é Dinheiro
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps} 
            title="Organização Sistemática"
            subtitle="Colocamos a casa em ordem."
        />

		<!-- 3. O Que Entregamos (Outputs) -->
		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<FileText class="w-5 h-5" />
					Suporte Completo
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Settings class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<!-- 5. Mini-caso (Cenário Real) -->
		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<FolderArchive class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Ordem Total</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						Cansado de apagar fogos?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Deixe-nos gerir a rotina para que possa focar-se em fazer crescer o negócio.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Pedir Proposta de Apoio
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
</style>
