---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Leaf, FileText, Activity, AlertTriangle, ArrowRight, Phone, Mail, ChevronLeft, Droplets, Trees, Wind } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Consultoria Ambiental',
	ref: 'Ambiente',
	problem: 'Ignorar a componente ambiental não é apenas ilegal—é um risco financeiro e reputacional. Multas pesadas, embargos de obra e rejeição comunitária podem destruir projectos que, tecnicamente, seriam viáveis. A sustentabilidade deixou de ser "nice to have" para ser obrigatória.',
	approach: 'Tratamos o ambiente como um activo de negócio. A nossa consultoria vai além da obtenção da licença; desenhamos estratégias de mitigação que reduzem custos operacionais (ex: gestão de resíduos e água) e blindam a reputação da sua empresa junto de stakeholders e investidores.',
	outputs: [
		{ title: 'Estudos de Impacto (EIA)', desc: 'Documentação rigorosa para licenciamento ambiental (Cat A, B e C).' },
		{ title: 'Planos de Gestão Ambiental', desc: 'Sistemas práticos para controlo diário em obra/operação.' },
		{ title: 'Auditorias de Conformidade', desc: 'Checkups regulares para garantir cumprimento da lei.' },
		{ title: 'Monitoria Ambiental', desc: 'Análise de qualidade do ar, água e ruído.' }
	],
	tools: [
		'Equipamento de Medição de Qualidade do Ar',
		'Sondas Multiparamétricas (Água)',
		'Modelagem de Dispersão de Poluentes',
		'GIS para Mapeamento de Sensibilidade Ambiental'
	],
	caseStudy: {
		title: 'Licenciamento de Indústria em Zona Sensível',
		scenario: 'Uma fábrica pretendia instalar-se perto de uma zona húmida. O risco de rejeição pelo Ministério era de 90% devido ao potencial de contaminação.',
		result: 'Desenvolvemos um sistema de circuito fechado para tratamento de efluentes e um plano de regeneração da flora local. O projecto foi aprovado como "Exemplo de Sustentabilidade" e atraiu financiamento verde.'
	}
};

const pros = ["Indústrias extractivas e de manufactura", "Grandes obras de infra-estrutura", "Empresas que precisam de renovar licenças"];
const cons = ["Pequenos comércios sem impacto significativo", "Quem quer 'comprar' uma licença sem cumprir regras"];

const methodologySteps = [
    { title: "Screening", description: "Avaliação preliminar e enquadramento legal do projecto." },
    { title: "Estudos de Base", description: "Recolha de dados no terreno (Biofísico e Socioeconómico)." },
    { title: "Avaliação de Impacto", description: "Cálculo científico dos efeitos positivos e negativos." },
    { title: "Plano de Gestão (PGA)", description: "Definição de medidas para evitar ou curar os danos." },
    { title: "Licenciamento e Seguimento", description: "Submissão e acompanhamento das auditorias." }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Estudos de impacto ambiental, gestão de resíduos e sustentabilidade."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Leaf class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Consultoria </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Ambiental
						</span>
					</h1>
				</div>
			</div>
		</section>
        
        <!-- Environmental Dashboard Visualization -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
            <div class="container mx-auto px-6">
                <div class="text-center mb-10">
                    <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">Monitoria Real</span>
                    <h2 class="text-3xl font-bold text-white mb-2">Indicadores de Impacto</h2>
                    <p class="text-gray-400">Transformamos dados ambientais complexos em gestão simples.</p>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8">
                     <!-- Indicator Card 1 -->
                     <div class="bg-dark-200 rounded-2xl p-6 border border-white/5 relative overflow-hidden group hover:-translate-y-1 transition-transform">
                         <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/10 rounded-full blur-xl -mr-8 -mt-8 group-hover:bg-blue-500/20 transition-colors"></div>
                         <Droplets class="w-8 h-8 text-blue-400 mb-4" />
                         <h3 class="text-xl font-bold text-white mb-1">Qualidade da Água</h3>
                         <div class="text-3xl font-bold text-white mb-2">pH 7.2</div>
                         <div class="w-full bg-gray-700 h-2 rounded-full overflow-hidden">
                             <div class="w-[70%] h-full bg-blue-400 rounded-full"></div>
                         </div>
                         <p class="text-xs text-gray-400 mt-2">Dentro dos parâmetros normais</p>
                     </div>

                     <!-- Indicator Card 2 -->
                     <div class="bg-dark-200 rounded-2xl p-6 border border-white/5 relative overflow-hidden group hover:-translate-y-1 transition-transform">
                         <div class="absolute top-0 right-0 w-24 h-24 bg-green-500/10 rounded-full blur-xl -mr-8 -mt-8 group-hover:bg-green-500/20 transition-colors"></div>
                         <Trees class="w-8 h-8 text-green-400 mb-4" />
                         <h3 class="text-xl font-bold text-white mb-1">Reflorestamento</h3>
                         <div class="text-3xl font-bold text-white mb-2">1,250</div>
                         <div class="w-full bg-gray-700 h-2 rounded-full overflow-hidden">
                             <div class="w-[85%] h-full bg-green-400 rounded-full"></div>
                         </div>
                         <p class="text-xs text-gray-400 mt-2">Árvores plantadas este ano</p>
                     </div>

                     <!-- Indicator Card 3 -->
                     <div class="bg-dark-200 rounded-2xl p-6 border border-white/5 relative overflow-hidden group hover:-translate-y-1 transition-transform">
                         <div class="absolute top-0 right-0 w-24 h-24 bg-yellow-500/10 rounded-full blur-xl -mr-8 -mt-8 group-hover:bg-yellow-500/20 transition-colors"></div>
                         <Wind class="w-8 h-8 text-yellow-400 mb-4" />
                         <h3 class="text-xl font-bold text-white mb-1">Emissões CO2</h3>
                         <div class="text-3xl font-bold text-white mb-2">-15%</div>
                         <div class="w-full bg-gray-700 h-2 rounded-full overflow-hidden">
                             <div class="w-[45%] h-full bg-yellow-400 rounded-full"></div>
                         </div>
                         <p class="text-xs text-gray-400 mt-2">Redução face ao ano anterior</p>
                     </div>
                </div>

                <div class="mt-12 p-8 rounded-2xl bg-dark-200 border border-white/10 text-center">
                    <h3 class="text-xl font-bold text-white mb-4">O Equilíbrio Sustentável</h3>
                    <div class="max-w-2xl mx-auto flex justify-center py-6">
                        <!-- Simple Venn Diagram using CSS circles with opacity overlap -->
                        <div class="relative w-64 h-48">
                            <div class="absolute w-32 h-32 bg-green-500/30 rounded-full top-0 left-0 mix-blend-screen flex items-center justify-center text-xs font-bold text-green-200 border border-green-500/50">Ambiente</div>
                            <div class="absolute w-32 h-32 bg-blue-500/30 rounded-full top-0 right-0 mix-blend-screen flex items-center justify-center text-xs font-bold text-blue-200 border border-blue-500/50">Economia</div>
                            <div class="absolute w-32 h-32 bg-gold-500/30 rounded-full bottom-0 left-1/2 -translate-x-1/2 mix-blend-screen flex items-center justify-center text-xs font-bold text-gold-200 border border-gold-500/50">Comunidade</div>
                            <div class="absolute top-[45%] left-1/2 -translate-x-1/2 -translate-y-1/2 text-white font-bold tracking-widest text-shadow-sm">BMC</div>
                        </div>
                    </div>
                    <p class="text-gray-400">A nossa consultoria garante que o seu projecto respeita o ambiente, beneficia a comunidade e gera lucro.</p>
                </div>
            </div>
        </section>

		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<AlertTriangle class="w-5 h-5" />
						Risco Zero
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps} 
            title="Do Estudo à Licença"
            subtitle="Caminho seguro e legal."
        />

		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<FileText class="w-5 h-5" />
					Entregáveis Técnicos
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Activity class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<Leaf class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Harmonia</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						O seu projecto está em conformidade?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Evite multas e atrasos. Garanta a sustentabilidade legal e ambiental do seu investimento.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Pedir Avaliação Preliminar
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
    
    .text-shadow-sm {
        text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }
</style>
