---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { GraduationCap, Users, BookOpen, Award, ArrowRight, Phone, Mail, ChevronLeft, Lightbulb, TrendingUp } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Formação e Desenvolvimento Profissional',
	ref: 'Formação',
	problem: 'Treinamentos genéricos de "fim-de-semana" motivam as pessoas por 48 horas, mas não mudam comportamentos. O investimento em formação perde-se se não estiver ligado a competências práticas e aplicáveis imediatamente no contexto real de trabalho.',
	approach: 'Desenhamos jornadas de aprendizagem, não apenas eventos. A nossa metodologia 70:20:10 foca na prática e aplicação (70%), troca de experiências (20%) e teoria (10%). Usamos simulações reais e gamificação para garantir que o conhecimento cola.',
	outputs: [
		{ title: 'Plano de Formação Anual', desc: 'Levantamento de necessidades e calendário estratégico.' },
		{ title: 'Workshops Customizados', desc: 'Conteúdo desenhado à medida da sua indústria.' },
		{ title: 'Programas de Liderança', desc: 'Academia intensiva para gestores e chefias.' },
		{ title: 'Avaliação de Impacto', desc: 'Medição do ROI da formação e mudança comportamental.' }
	],
	tools: [
		'LMS (Learning Management Systems)',
		'Ferramentas de Gamificação (Kahoot / Mentimeter)',
		'Estudos de Caso Harvard Business Review',
		'Role-playing e Simulações'
	],
	caseStudy: {
		title: 'Academia de Vendas Corporativa',
		scenario: 'Uma equipa comercial de um banco tinha conhecimento técnico dos produtos, mas falhava no fecho de vendas e na relação com o cliente.',
		result: 'Criámos uma "Escola de Vendas" de 6 meses com coaching no terreno. A taxa de conversão aumentou 35% e o índice de satisfação do cliente subiu de 3/5 para 4.8/5.'
	}
};

const pros = ["Empresas que querem reter talento", "Equipas de vendas agressivas", "Novos gestores a assumir liderança"];
const cons = ["Quem procura apenas certificados sem aprender", "Formações de 'teambuilding' só para lazer"];

const methodologySteps = [
    { title: "Diagnóstico de Competências (Gap Analysis)", description: "Identificamos o que a equipa sabe vs. o que precisa saber." },
    { title: "Design Instrucional", description: "Criação de materiais e dinâmicas adaptadas ao público." },
    { title: "Entrega Dinâmica", description: "Sessões presenciais ou híbridas focadas na prática." },
    { title: "Plano de Acção Individual", description: "Compromisso de aplicação prática pós-formação." },
    { title: "Follow-up de Resultados", description: "Sessão de retorno 30 dias depois para medir progresso." }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Capacitação, team building e desenvolvimento de liderança em Moçambique."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<GraduationCap class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Formação </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							& Desenvolvimento
						</span>
					</h1>
				</div>
			</div>
		</section>

        <!-- Learning Paths Visualization -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
             <div class="container mx-auto px-6">
                 <div class="text-center mb-16">
                     <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">Não é "One size fits all"</span>
                     <h2 class="text-3xl font-bold text-white mb-2">Trilhas de Aprendizagem</h2>
                     <p class="text-gray-400">Desenhe o percurso certo para cada perfil da sua empresa.</p>
                 </div>
                 
                 <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
                     <!-- Track A: Operational -->
                     <div class="relative pl-8 border-l-2 border-blue-500/30 space-y-8">
                         <div class="absolute -left-3 -top-3 w-6 h-6 rounded-full bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)]"></div>
                         <h3 class="text-2xl font-bold text-white mb-6">Trilha Operacional & Vendas</h3>
                         
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-blue-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-blue-500/10 transition-colors">
                                 <h4 class="font-bold text-white">1. Atendimento de Excelência</h4>
                                 <p class="text-sm text-gray-400">Comunicação e resolução de conflitos.</p>
                             </div>
                         </div>
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-blue-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-blue-500/10 transition-colors">
                                 <h4 class="font-bold text-white">2. Técnicas de Negociação</h4>
                                 <p class="text-sm text-gray-400">Fecho de vendas e persuasão ética.</p>
                             </div>
                         </div>
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-blue-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-blue-500/10 transition-colors">
                                 <h4 class="font-bold text-white">3. Produtividade Pessoal</h4>
                                 <p class="text-sm text-gray-400">Gestão de tempo e prioridades.</p>
                             </div>
                         </div>
                     </div>

                     <!-- Track B: Leadership -->
                     <div class="relative pl-8 border-l-2 border-gold-500/30 space-y-8">
                         <div class="absolute -left-3 -top-3 w-6 h-6 rounded-full bg-gold-500 shadow-[0_0_15px_rgba(234,179,8,0.5)]"></div>
                         <h3 class="text-2xl font-bold text-white mb-6">Trilha de Liderança</h3>
                         
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-gold-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-gold-500/10 transition-colors">
                                 <h4 class="font-bold text-white">1. Gestão de Pessoas 3.0</h4>
                                 <p class="text-sm text-gray-400">Liderança situacional e feedback.</p>
                             </div>
                         </div>
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-gold-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-gold-500/10 transition-colors">
                                 <h4 class="font-bold text-white">2. Pensamento Estratégico</h4>
                                 <p class="text-sm text-gray-400">Visão sistémica do negócio.</p>
                             </div>
                         </div>
                         <div class="relative group">
                             <div class="absolute -left-[41px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-dark-100 border-2 border-gold-500"></div>
                             <div class="bg-dark-200 p-5 rounded-xl border border-white/5 group-hover:bg-gold-500/10 transition-colors">
                                 <h4 class="font-bold text-white">3. Alta Performance</h4>
                                 <p class="text-sm text-gray-400">Gestão de resultados e KPIs.</p>
                             </div>
                         </div>
                     </div>
                 </div>
                 
                 <!-- Certificate Mockup -->
                 <div class="mt-16 text-center">
                     <div class="inline-block p-1 rounded-2xl bg-gradient-to-r from-gold-500/20 via-white/5 to-gold-500/20">
                         <div class="bg-dark-200 rounded-xl px-8 py-4 flex items-center gap-4">
                             <Award class="w-8 h-8 text-gold-500" />
                             <div class="text-left">
                                 <span class="block text-white font-bold">Certificação Verificável</span>
                                 <span class="text-xs text-gray-400">Todos os formandos recebem certificado digital com QR Code.</span>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>
        </section>

		<!-- 1. O Problema Real -->
		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<Users class="w-5 h-5" />
						O Desafio
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps} 
            title="Aprender Fazendo"
            subtitle="Metodologia activa e participativa."
        />

		<!-- 3. O Que Entregamos (Outputs) -->
		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<BookOpen class="w-5 h-5" />
					Entregáveis Concretos
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Lightbulb class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<!-- 5. Mini-caso (Cenário Real) -->
		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<TrendingUp class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Resultados</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. CTA Inteligente -->
		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						Quer uma equipa de alta performance?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Invista em conhecimento que traz retorno. Vamos desenhar o plano de formação ideal.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Pedir Catálogo de Cursos
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
</style>
