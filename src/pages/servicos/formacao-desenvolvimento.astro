---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { GraduationCap, Check, ArrowRight, Phone, Mail, ChevronLeft } from 'lucide-astro';
import '../../styles/global.css';

const service = {
	icon: GraduationCap,
	title: 'Formação e Desenvolvimento Profissional',
	description: 'Capacitamos equipas em diversas áreas de gestão, tecnologia e liderança, promovendo ambientes de trabalho mais produtivos e eficazes.',
	longDescription: 'O capital humano é o activo mais valioso de qualquer organização. Desenvolvemos programas de formação personalizados que capacitam equipas, desenvolvem competências de liderança e criam culturas organizacionais de alto desempenho.',
	subServices: [
		{ name: 'Treinamentos corporativos', description: 'Programas customizados para necessidades específicas da empresa.' },
		{ name: 'Team building', description: 'Actividades para fortalecer coesão e colaboração de equipas.' },
		{ name: 'Workshops técnicos', description: 'Sessões práticas sobre ferramentas e metodologias específicas.' },
		{ name: 'Programas de liderança', description: 'Desenvolvimento de competências de gestão e liderança.' },
		{ name: 'Formação modular', description: 'Módulos flexíveis adaptados à disponibilidade da equipa.' }
	],
	benefits: [
		'Formadores experientes com background empresarial',
		'Metodologias activas e participativas',
		'Certificação reconhecida',
		'Acompanhamento pós-formação'
	]
};
---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description={service.description}
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<GraduationCap class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Formação e </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Desenvolvimento Profissional
						</span>
					</h1>
					
					<p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl">
						{service.longDescription}
					</p>
					
					<div class="flex flex-wrap gap-4">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-semibold hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Solicitar Proposta
							<ArrowRight class="w-5 h-5" />
						</a>
						<a href="tel:+258820883478" class="px-8 py-4 rounded-xl border-2 border-gold-500/50 text-gold-500 font-semibold hover:bg-gold-500/10 transition-all flex items-center gap-2">
							<Phone class="w-5 h-5" />
							+258 82 088 3478
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="py-20 relative">
			<div class="container mx-auto px-6">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4 text-center">O Que Oferecemos</h2>
				<p class="text-gray-300 text-center mb-12 max-w-2xl mx-auto">
					Programas de formação que transformam equipas e impulsionam resultados.
				</p>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					{service.subServices.map((sub) => (
						<div class="glass-dark rounded-2xl p-6 border border-gold-500/20 hover:border-gold-500/40 transition-all group">
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 rounded-xl bg-gold-500/20 flex items-center justify-center flex-shrink-0 group-hover:bg-gold-500/30 transition-colors">
									<Check class="w-5 h-5 text-gold-500" />
								</div>
								<div>
									<h3 class="text-lg font-semibold text-white mb-2">{sub.name}</h3>
									<p class="text-gray-300 text-sm leading-relaxed">{sub.description}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="py-20 relative bg-dark-100/50">
			<div class="container mx-auto px-6">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">Porquê Escolher-nos</h2>
					<div class="grid md:grid-cols-2 gap-6">
						{service.benefits.map((benefit) => (
							<div class="flex items-start gap-4 p-6 rounded-xl bg-gradient-to-r from-gold-500/5 to-transparent border-l-2 border-gold-500">
								<Check class="w-6 h-6 text-gold-500 flex-shrink-0 mt-0.5" />
								<p class="text-gray-200 leading-relaxed">{benefit}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="py-20 relative">
			<div class="container mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Quer Desenvolver a Sua Equipa?</h2>
				<p class="text-gray-300 mb-8 max-w-2xl mx-auto">
					Fale connosco sobre as necessidades de formação da sua organização.
				</p>
				<a href="/contact" class="inline-flex px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-semibold hover:glow-gold-lg transition-all transform hover:scale-105 items-center gap-2">
					<Mail class="w-5 h-5" />
					Contactar Agora
				</a>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
</style>
