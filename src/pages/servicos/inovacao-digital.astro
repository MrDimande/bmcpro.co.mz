---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Cpu, Check, ArrowRight, Phone, Mail, ChevronLeft } from 'lucide-astro';
import '../../styles/global.css';

const service = {
	icon: Cpu,
	title: 'Inovação Digital & Smart Solutions',
	description: 'Integramos ferramentas tecnológicas que aceleram processos, melhoram decisões e trazem eficiência às operações.',
	longDescription: 'A transformação digital é essencial para a competitividade moderna. Implementamos soluções tecnológicas inovadoras que automatizam processos, melhoram a tomada de decisão baseada em dados e preparam a sua organização para os desafios do futuro digital.',
	subServices: [
		{ name: 'Digitalização de processos', description: 'Transformação de fluxos manuais em sistemas digitais eficientes.' },
		{ name: 'Implementação de Better Rides, KoboCollect', description: 'Configuração de plataformas especializadas de recolha de dados.' },
		{ name: 'Soluções de georreferenciação', description: 'Sistemas de mapeamento e localização para gestão territorial.' },
		{ name: 'Dashboards e relatórios digitais', description: 'Painéis de controlo interactivos para visualização de dados.' },
		{ name: 'Web development e sistemas de gestão', description: 'Websites, aplicações web e sistemas personalizados.' }
	],
	benefits: [
		'Especialistas em tecnologias emergentes e GIS',
		'Soluções escaláveis adaptadas ao seu orçamento',
		'Formação incluída para autonomia da equipa',
		'Suporte técnico contínuo pós-implementação'
	]
};
---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description={service.description}
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<!-- Hero Section -->
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Cpu class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Inovação </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Digital & Smart Solutions
						</span>
					</h1>
					
					<p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl">
						{service.longDescription}
					</p>
					
					<div class="flex flex-wrap gap-4">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-semibold hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Solicitar Proposta
							<ArrowRight class="w-5 h-5" />
						</a>
						<a href="tel:+258820883478" class="px-8 py-4 rounded-xl border-2 border-gold-500/50 text-gold-500 font-semibold hover:bg-gold-500/10 transition-all flex items-center gap-2">
							<Phone class="w-5 h-5" />
							+258 82 088 3478
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Sub-services Section -->
		<section class="py-20 relative">
			<div class="container mx-auto px-6">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-4 text-center">O Que Oferecemos</h2>
				<p class="text-gray-300 text-center mb-12 max-w-2xl mx-auto">
					Soluções tecnológicas de ponta para modernizar a sua organização.
				</p>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					{service.subServices.map((sub, index) => (
						<div class="glass-dark rounded-2xl p-6 border border-gold-500/20 hover:border-gold-500/40 transition-all group">
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 rounded-xl bg-gold-500/20 flex items-center justify-center flex-shrink-0 group-hover:bg-gold-500/30 transition-colors">
									<Check class="w-5 h-5 text-gold-500" />
								</div>
								<div>
									<h3 class="text-lg font-semibold text-white mb-2">{sub.name}</h3>
									<p class="text-gray-300 text-sm leading-relaxed">{sub.description}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Benefits Section -->
		<section class="py-20 relative bg-dark-100/50">
			<div class="container mx-auto px-6">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">Porquê Escolher-nos</h2>
					
					<div class="grid md:grid-cols-2 gap-6">
						{service.benefits.map((benefit) => (
							<div class="flex items-start gap-4 p-6 rounded-xl bg-gradient-to-r from-gold-500/5 to-transparent border-l-2 border-gold-500">
								<Check class="w-6 h-6 text-gold-500 flex-shrink-0 mt-0.5" />
								<p class="text-gray-200 leading-relaxed">{benefit}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-20 relative">
			<div class="container mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
					Pronto para a Transformação Digital?
				</h2>
				<p class="text-gray-300 mb-8 max-w-2xl mx-auto">
					Descubra como as nossas soluções tecnológicas podem revolucionar os seus processos.
				</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-semibold hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
						<Mail class="w-5 h-5" />
						Contactar Agora
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
</style>
