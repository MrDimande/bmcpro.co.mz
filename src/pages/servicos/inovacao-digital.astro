---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { Cpu, Server, Smartphone, Globe, Cloud, ArrowRight, Video, ChevronLeft, Database, Code, CheckCircle2 } from 'lucide-astro';
import ServiceProsCons from '../../components/services/ServiceProsCons.astro';
import MethodologyTimeline from '../../components/services/MethodologyTimeline.astro';
import '../../styles/global.css';

const service = {
	title: 'Inovação Digital & Smart Solutions',
	ref: 'Digital',
	problem: 'Empresas perdem 30% da produtividade em tarefas repetitivas e decisões lentas baseadas em papel ou Excel. Sem digitalização, a sua operação é uma caixa negra, e a concorrência ágil está a roubar-lhe clientes.',
	approach: 'Não instalamos tecnologia por instalar. Primeiro, mapeamos a dor operacional. Depois, desenhamos a solução digital (Web, Mobile ou Data) que resolve o problema. O nosso foco é o ROI: se não poupa tempo ou gera dinheiro, não implementamos.',
	outputs: [
		{ title: 'Plataformas de Gestão', desc: 'Sistemas web personalizados para operações complexas.' },
		{ title: 'Apps de Recolha de Dados', desc: 'Soluções móveis offline-first (KoboToolbox, ODK).' },
		{ title: 'Dashboards Executivos', desc: 'Visualização de dados para decisão em tempo real (BI).' },
		{ title: 'Automação de Processos', desc: 'Bots e scripts para eliminar trabalho manual.' }
	],
	tools: [
		'React / Next.js / Astro (Web Apps Modernas)',
		'Flutter (Mobile Nativo)',
		'PostgreSQL / Supabase (Bases de Dados Robustas)',
		'PowerBI / Metabase (Business Intelligence)'
	],
	caseStudy: {
		title: 'Digitalização de Fiscalização Agrícola',
		scenario: 'Uma agência de fomento agrário demorava 3 meses para processar relatórios de campo em papel de 5.000 agricultores, tornando os dados irrelevantes para a época de sementeira.',
		result: 'Implementámos uma solução móvel com sincronização offline. O tempo de processamento caiu para 48 horas. A agência conseguiu alertar pragas em tempo real, salvando 20% da colheita.'
	}
};

const pros = ["Organizações com equipas de campo (ONGs, Agricultura, Logística)", "Empresas com processos manuais pesados", "Gestores que querem ver dados em tempo real"];
const cons = ["Quem procura apenas 'um site bonito' sem funcionalidade", "Sistemas legados fechados que não permitem integração"];

const methodologySteps = [
    { title: "Mapeamento de Processos", description: "Entendemos o fluxo de informação manual actual." },
    { title: "Prototipagem (UX/UI)", description: "Desenhamos as telas para validação antes de programar." },
    { title: "Desenvolvimento Ágil", description: "Sprints de entrega contínua com feedback quinzenal." },
    { title: "Testes e Piloto", description: "Validação em ambiente controlado com utilizadores reais." },
    { title: "Formação e Suporte", description: "Garantia de adopção pela equipa." }
];

const solutionsCatalog = [
    { problem: "Perda de informação em formulários de papel", solution: "App Mobile Offline", impact: "Dados 100% seguros e digitais" },
    { problem: "Relatórios mensais que demoram semanas", solution: "Dashboard Automático", impact: "Decisão imediata" },
    { problem: "Falhas de comunicação entre equipas", solution: "Portal Interno", impact: "Alinhamento total" },
    { problem: "Gestão de stocks ineficiente", solution: "Sistema de Inventário QR Code", impact: "-40% de quebras" }
];

---

<Layout 
	title={`${service.title} - Serviços BMC Pro`}
	description="Transformação digital, desenvolvimento de software e soluções smart em Moçambique."
>
	<Header />
	<main class="min-h-screen bg-gradient-to-b from-dark-200 via-dark-100 to-dark-200">
		<section class="pt-32 pb-20 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-gold-500/5 to-transparent"></div>
			<div class="absolute top-20 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<a href="/services" class="inline-flex items-center gap-2 text-gray-300 hover:text-gold-500 transition-colors mb-8 group">
					<ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
					Voltar aos Serviços
				</a>
				
				<div class="max-w-4xl">
					<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-gold-600/30 to-gold-500/10 flex items-center justify-center mb-8 glow-gold">
						<Cpu class="w-10 h-10 text-gold-500" stroke-width="1.5" />
					</div>
					
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
						<span class="text-white">Inovação </span>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">
							Digital & Smart Solutions
						</span>
					</h1>
				</div>
			</div>
		</section>

        <!-- POC / Demo Section -->
        <section class="py-16 bg-dark-300/30 border-y border-white/5">
             <div class="container mx-auto px-6">
                 <div class="text-center mb-10">
                     <span class="text-gold-500 font-bold text-sm tracking-widest uppercase mb-2 block">Prova de Conceito</span>
                     <h2 class="text-3xl font-bold text-white mb-2">Veja o Futuro da Sua Operação</h2>
                     <p class="text-gray-400">Exemplos reais de interfaces que criamos.</p>
                 </div>

                 <div class="grid lg:grid-cols-2 gap-12 items-center">
                     <!-- Dashboard Mockup -->
                     <div class="rounded-xl border border-white/10 bg-dark-200 p-2 shadow-2xl overflow-hidden relative group">
                         <div class="absolute inset-0 bg-gold-500/5 group-hover:bg-gold-500/10 transition-colors pointer-events-none z-10"></div>
                         <div class="bg-dark-100 rounded-lg p-6 space-y-6">
                             <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                                 <div class="font-bold text-white">Dashboard Operacional</div>
                                 <div class="flex gap-2">
                                     <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                     <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                     <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                 </div>
                             </div>
                             <div class="grid grid-cols-3 gap-4">
                                 <div class="bg-gray-800/50 p-4 rounded text-center">
                                     <div class="text-xs text-gray-400">Receita</div>
                                     <div class="text-xl font-bold text-green-400">1.2M</div>
                                 </div>
                                 <div class="bg-gray-800/50 p-4 rounded text-center">
                                     <div class="text-xs text-gray-400">Clientes</div>
                                     <div class="text-xl font-bold text-white">340</div>
                                 </div>
                                 <div class="bg-gray-800/50 p-4 rounded text-center">
                                     <div class="text-xs text-gray-400">Tickets</div>
                                     <div class="text-xl font-bold text-gold-500">12</div>
                                 </div>
                             </div>
                             <div class="h-32 bg-gray-800/30 rounded flex items-end justify-between px-4 pb-2">
                                  {[40, 60, 45, 80, 55, 90, 70].map(h => (
                                      <div style={{height: `${h}%`}} class="w-8 bg-gold-500/50 rounded-t hover:bg-gold-500 transition-colors"></div>
                                  ))}
                             </div>
                         </div>
                     </div>

                     <!-- Solution Catalog -->
                     <div class="space-y-6">
                         <h3 class="text-2xl font-bold text-white mb-6">Catálogo de Resolução de Problemas</h3>
                         <div class="space-y-4">
                             {solutionsCatalog.map((item) => (
                                 <div class="p-4 rounded-xl bg-dark-200 border border-white/5 hover:border-gold-500/30 transition-all group/item">
                                     <div class="flex items-start gap-4">
                                         <div class="mt-1 w-8 h-8 rounded-full bg-gold-500/10 flex items-center justify-center flex-shrink-0 text-gold-500">
                                             <CheckCircle2 class="w-5 h-5" />
                                         </div>
                                         <div>
                                             <p class="text-red-400 text-sm font-medium mb-1">Problema: {item.problem}</p>
                                             <p class="text-white font-bold">{item.solution}</p>
                                             <p class="text-green-400 text-sm mt-1">Impacto: {item.impact}</p>
                                         </div>
                                     </div>
                                 </div>
                             ))}
                         </div>
                     </div>
                 </div>
             </div>
        </section>

		<section class="py-16 relative">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl">
					<h2 class="text-xl text-gold-500 font-semibold mb-4 flex items-center gap-2">
						<Code class="w-5 h-5" />
						A Caixa Negra
					</h2>
					<p class="text-2xl md:text-3xl text-white font-medium leading-relaxed">
						{service.problem}
					</p>
				</div>
			</div>
		</section>

        <MethodologyTimeline 
            steps={methodologySteps} 
            title="Desenvolvimento sem Surpresas"
            subtitle="Metodologia ágil que garante entregas rápidas."
        />

		<section class="py-20 relative bg-dark-100/30">
			<div class="container mx-auto px-6">
				<h2 class="text-xl text-gold-500 font-semibold mb-8 flex items-center gap-2">
					<Database class="w-5 h-5" />
					Stack Tecnológico
				</h2>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					{service.outputs.map((output) => (
						<div class="glass-dark p-6 rounded-xl border border-gold-500/10 hover:border-gold-500/30 transition-all group hover:-translate-y-1">
							<Cloud class="w-8 h-8 text-gold-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="text-lg font-bold text-white mb-2">{output.title}</h3>
							<p class="text-sm text-gray-400">{output.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

        <ServiceProsCons idealFor={pros} notIdealFor={cons} />

		<section class="py-20 relative overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-dark-300 to-dark-100 border border-gold-500/20 p-8 md:p-12 relative">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
					
					<div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
						<div class="md:w-1/3">
							<div class="bg-gold-500/10 rounded-2xl p-6 text-center border border-gold-500/20">
								<Smartphone class="w-12 h-12 text-gold-500 mx-auto mb-4" />
								<p class="text-gold-400 font-bold text-lg">Eficiência Móvel</p>
								<p class="text-white/60 text-sm mt-2">{service.caseStudy.title}</p>
							</div>
						</div>
						<div class="md:w-2/3">
							<h3 class="text-2xl font-bold text-white mb-4">Cenário</h3>
							<p class="text-gray-300 leading-relaxed mb-6">"{service.caseStudy.scenario}"</p>
							
							<div class="pl-4 border-l-2 border-gold-500">
								<h4 class="text-lg font-bold text-white mb-2">Resultado</h4>
								<p class="text-gray-300">{service.caseStudy.result}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="py-20 relative text-center">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
						Quer eliminar as folhas de papel da sua empresa?
					</h2>
					<p class="text-xl text-gray-300 mb-10">
						Vamos automatizar os seus processos e dar-lhe controlo total em tempo real.
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="/contact" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-600 to-gold-500 text-dark-200 font-bold text-lg hover:glow-gold-lg transition-all transform hover:scale-105 flex items-center gap-2">
							Agendar Demonstração de Soluções
							<ArrowRight class="w-5 h-5" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<CookieConsent />
</Layout>

<style>
	.glass-dark {
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(10px);
	}
	
	.hover\:glow-gold-lg:hover {
		box-shadow: 0 0 30px rgba(234, 179, 8, 0.3);
	}
</style>
